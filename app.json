{
  "expo": {
    "name": "UBAGO",
    "slug": "ubago",
    "owner": "juansebas999",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ubago.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "UBAGO necesita tu ubicación para mostrarte conductores cercanos y calcular rutas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "UBAGO necesita tu ubicación en segundo plano si eres conductor.",
        "NSCameraUsageDescription": "UBAGO necesita acceso a la cámara para registrar tu vehículo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ubago.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "UBAGO necesita tu ubicación para conectarte con conductores.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UBAGO necesita acceso a tus fotos para tu perfil."
        }
      ]
    ],
    "scheme": "ubago",
    "extra": {
      "eas": {
        "projectId": "426a3f5f-c4f7-4b0c-9abe-44953e320d32"
      }
    }
  }
}