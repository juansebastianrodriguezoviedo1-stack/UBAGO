{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "src",
    "App.tsx",
    "index.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "api_routes_backup_disabled",
    "api_routes_backup_disabled/**",
    "src/services/stripe.service.ts",
    ".expo",
    "android",
    "ios",
    "scratch"
  ]
}




